# Neon Postgres pooled connection string. Include sslmode=require.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Groq credentials and model IDs.
GROQ_API_KEY="gsk_..."
CHAT_MODEL="openai/gpt-oss-20b"
FAST_MODEL="llama-3.1-8b-instant"

# Exa web-search credentials.
EXA_API_KEY="replace-with-your-exa-api-key"

# Google Gemini embeddings. The model is requested at 1536 dimensions to match
# the pgvector schema.
GEMINI_API_KEY="replace-with-your-gemini-api-key"
EMBEDDING_MODEL="gemini-embedding-2"

# At least 32 random bytes, used to sign the anonymous identity cookie.
COOKIE_SECRET=""
